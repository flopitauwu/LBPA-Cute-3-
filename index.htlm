<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LBPA Cute · Ley de Bases del Procedimiento Administrativo</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

    <header class="hero">
        <h1>⚖ LBPA <span class="corazon">♡</span></h1>
