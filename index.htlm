        <div class="buscador">
            <input type="text" id="inputBuscador" placeholder="Buscar artículo, palabra o concepto...">
        </div>
    </header>

    <div id="resultadosBusqueda" class="resultados"></div>

    <main>
        <section class="capitulos"></section>
    </main>

    <script src="js/datos.js"></script>
    <script src="js/script.js"></script>
